// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A course/webinar listed on the platform. Content only — no personal data.
model Course {
  id               Int      @id @default(autoincrement())
  title            String
  /// Short blurb shown on the catalog card.
  description      String
  /// Full text shown on the course's own detail page.
  longDescription  String
  level            String?
  duration         String?
  schedule         String?
  createdAt        DateTime @default(now())

  enrollments Enrollment[]
}

/// A confirmed on-chain course registration, mirrored here for fast lookups
/// ("my courses", listing pages). The blockchain (CourseRegistry.sol) is the
/// source of truth for whether a registration is valid — this table is a
/// cache, written only after the backend independently verifies the
/// registerForCourse() transaction on-chain (never trusted from the client
/// alone). walletAddress is the user's identifier — no email/password.
model Enrollment {
  id            Int      @id @default(autoincrement())
  courseId      Int
  course        Course   @relation(fields: [courseId], references: [id])
  walletAddress String
  txHash        String
  registeredAt  DateTime @default(now())

  @@unique([courseId, walletAddress])
}

/// An event (meetup, conference, webinar, ...) whose tickets are sold through
/// TicketRegistry.sol. `id` is the same number the event has on-chain, so it is
/// assigned by hand (see data/events.json), not auto-incremented. The price,
/// capacity and times are also stored on-chain, which is the source of truth;
/// the descriptive fields only exist here.
model Event {
  id              Int      @id
  title           String
  description     String
  longDescription String
  category        String
  format          String
  location        String?
  startsAt        DateTime
  endsAt          DateTime
  /// Exact on-chain price in wei, as a string (too large for a JS number).
  priceWei        String
  capacity        Int
  createdAt       DateTime @default(now())

  tickets Ticket[]
}

/// A purchased ticket, mirrored here for fast "my tickets" lookups. Written only
/// after the backend independently re-reads the ticket from the chain (never
/// trusted from the client alone). `id` is the ticket id from the contract.
model Ticket {
  id           Int      @id
  eventId      Int
  event        Event    @relation(fields: [eventId], references: [id])
  ownerAddress String
  txHash       String
  purchasedAt  DateTime @default(now())

  @@unique([eventId, ownerAddress])
}
